
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Curriculum content is public for any signed-in user
    match /lessons/{lessonId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // Admin only for writes
    }

    match /mockTests/{testId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // Admin only for writes
    }

    match /readingTests/{testId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // Admin only for writes
    }

    match /listeningTests/{testId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // Admin only for writes
    }

    // User-specific data is restricted to the owner
    match /users/{userId}/submissions/{submissionId} {
      allow read, list, create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/learningPaths/{learningPathId} {
      allow read, list, create, update, delete: if isOwner(userId);
    }
  }
}
