rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow all reads and writes for now (development mode)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Allow all reads and writes for now (development mode)
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
