
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requested user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * @description Checks if the user is a designated admin by their UID.
     */
    function isAdmin() {
      let admin_uids = ['yTh2178GN3ZV3mAGi3wAmdPOKlm1'];
      return isSignedIn() && request.auth.uid in admin_uids;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Allow admins or server-side processes to manage all curriculum and test content.
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth == null;
    }

    match /mockTests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth == null;
    }

    match /readingTests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth == null;
    }

    match /listeningTests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth == null;
    }
    
    match /knowledge/{chunkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth == null;
    }

    // User-specific data is restricted to the owner
    match /users/{userId}/submissions/{submissionId} {
      allow read, list, create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/learningPaths/{learningPathId} {
      allow read, list, create, update, delete: if isOwner(userId);
    }
  }
}
