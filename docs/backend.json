
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user profile and their progress within the AI-Band-Builder application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity.",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "photoURL": {
          "type": "string",
          "description": "URL of the user's profile picture.",
          "format": "uri"
        },
        "nativeLanguage": {
          "type": "string",
          "description": "User's native language for multilingual support."
        },
        "currentBand": {
          "type": "number",
          "description": "User's current IELTS band score."
        },
        "targetBand": {
          "type": "number",
          "description": "User's target IELTS band score."
        },
        "learningPathId": {
          "type": "string",
          "description": "Reference to the LearningPath entity. (Relationship: User 1:1 LearningPath)"
        },
        "totalPracticeTime": {
          "type": "number",
          "description": "Total time spent by the user in practice sessions."
        }
      },
      "required": [
        "id",
        "email",
        "nativeLanguage",
        "currentBand",
        "targetBand"
      ]
    },
    "Lesson": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Lesson",
      "type": "object",
      "description": "Represents a static curriculum lesson within the AI-Band-Builder application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the lesson entity."
        },
        "type": {
          "type": "string",
          "description": "Type of lesson (e.g., Grammar, Vocabulary, Tips, Reading, Listening)."
        },
        "title": {
          "type": "string",
          "description": "Title of the lesson."
        },
        "level": {
          "type": "string",
          "description": "Difficulty level of the lesson (e.g., Basic, Intermediate, Advanced)."
        },
        "content_en": {
          "type": "string",
          "description": "Full lesson content in English."
        },
        "exercises": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {"type": "string", "enum": ["gap-fill", "sentence-transformation", "matching", "sentence-building"]},
                    "instructions": {"type": "string"},
                    "questions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "question": {"type": "string"},
                                "answer": {"type": "string"}
                            },
                            "required": ["question", "answer"]
                        }
                    }
                },
                "required": ["type", "instructions", "questions"]
            }
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "level",
        "content_en"
      ]
    },
     "SpeakingTest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SpeakingTest",
      "type": "object",
      "description": "Represents a single speaking test prompt.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the speaking test entity."
        },
        "title": {
          "type": "string",
          "description": "Title of the speaking prompt."
        },
        "level": {
            "type": "string",
            "enum": ["Part 1", "Part 2", "Part 3"]
        },
        "content_en": {
            "type": "string",
            "description": "The full text of the speaking prompt."
        },
         "skill": {
            "type": "string",
            "enum": ["Speaking"]
        }
      },
      "required": ["id", "title", "level", "content_en", "skill"]
    },
    "MockTest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MockTest",
      "type": "object",
      "description": "Represents a mock test definition, primarily for writing, within the AI-Band-Builder application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the mock test entity."
        },
        "testType": {
          "type": "string",
          "description": "Type of test (e.g., IELTS-Academic, PTE, IELTS-General)."
        },
        "skill": {
            "type": "string",
            "enum": ["Writing"]
        },
        "questions": {
          "type": "array",
          "description": "Array of question objects for the writing test.",
          "items": {
            "type": "object",
             "properties": {
                "task": {"type": "number"},
                "topic": {"type": "string"},
                "imageUrl": {
                  "type": "string",
                  "format": "uri",
                  "description": "Optional URL for an image or chart, typically for Task 1."
                },
                "taskType": {
                    "type": "string",
                    "enum": ["Task 1", "Task 2"]
                },
                "wordCountTarget": {"type": "number"}
            },
            "required": ["task", "topic", "taskType", "wordCountTarget"]
          }
        }
      },
      "required": [
        "id",
        "testType",
        "skill",
        "questions"
      ]
    },
     "ReadingTest": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ReadingTest",
        "type": "object",
        "description": "Represents a full reading test with multiple passages and questions.",
        "properties": {
            "id": {
                "type": "string",
                "description": "Unique identifier for the reading test."
            },
            "title": {
                "type": "string",
                "description": "Title of the reading test."
            },
             "skill": {
                "type": "string",
                "enum": ["Reading"]
            },
            "parts": {
                "type": "array",
                "description": "An array of test parts, each containing a passage and questions.",
                "items": {
                    "type": "object",
                    "properties": {
                        "part": {"type": "number"},
                        "title": {"type": "string"},
                        "passage": {"type": "string"},
                        "questions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "id": {"type": "string"},
                                    "question": {"type": "string"},
                                    "type": {
                                        "type": "string",
                                        "enum": ["multiple-choice", "true-false-not-given", "note-completion", "matching-headings", "matching-information", "summary-completion", "yes-no-not-given", "matching-sentence-endings", "fill-in-the-blank"]
                                    },
                                    "options": {
                                        "type": "array",
                                        "items": {"type": "string"}
                                    },
                                    "answer": {"type": "string"},
                                    "answerBox": {
                                        "type": "array",
                                        "items": {"type": "string"}
                                    }
                                },
                                "required": ["id", "question", "type", "answer"]
                            }
                        }
                    },
                    "required": ["part", "title", "passage", "questions"]
                }
            }
        },
        "required": ["id", "title", "skill", "parts"]
    },
    "ListeningTest": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ListeningTest",
        "type": "object",
        "description": "Represents a listening test with audio and questions.",
        "properties": {
            "id": {
                "type": "string",
                "description": "Unique identifier for the listening test."
            },
            "title": {
                "type": "string",
                "description": "Title of the listening test."
            },
             "skill": {
                "type": "string",
                "enum": ["Listening"]
            },
            "audioUrl": {
                "type": "string",
                "description": "URL to the audio file for the test.",
                "format": "uri"
            },
            "transcript": {
              "type": "string",
              "description": "The full text transcript of the audio file."
            },
            "questions": {
                "type": "array",
                "description": "An array of questions for the audio.",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {"type": "string"},
                        "question": {"type": "string"},
                        "type": {
                            "type": "string",
                            "enum": ["multiple-choice", "fill-in-the-blank"]
                        },
                        "options": {
                            "type": "array",
                            "items": {"type": "string"}
                        },
                        "answer": {"type": "string"}
                    },
                    "required": ["id", "question", "type", "answer"]
                }
            }
        },
        "required": ["id", "title", "skill", "audioUrl", "questions"]
    },
    "Submission": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Submission",
      "type": "object",
      "description": "Represents a user's submission and the AI-generated results within the AI-Band-Builder application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the submission entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the User entity. (Relationship: User 1:N Submission)"
        },
        "testId": {
          "type": "string",
          "description": "Reference to the MockTest or Lesson entity. (Relationship: MockTest/Lesson 1:N Submission)"
        },
        "skill": {
          "type": "string",
          "description": "Skill assessed in the submission (e.g., Writing, Speaking, Reading, Listening)."
        },
        "inputData": {
          "type": "string",
          "description": "The student's text response for Writing, or the Firebase Storage URL for their Speaking audio recording. For Reading/Listening, this can be a map of answers."
        },
        "aiReport": {
          "type": "string",
          "description": "Structured JSON report generated by the Gemini API."
        },
        "scoreBand": {
          "type": "number",
          "description": "The numerical band score assigned by the AI."
        },
        "timestamp": {
          "type": "string",
          "description": "Submission date and time.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "testId",
        "skill",
        "inputData",
        "scoreBand",
        "timestamp"
      ]
    },
    "LearningPath": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LearningPath",
      "type": "object",
      "description": "Represents a customized learning path for a user, linking to relevant lessons.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the learning path entity."
        },
        "lessonIds": {
          "type": "array",
          "description": "References to Lessons. (Relationship: LearningPath 1:N Lesson)",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "lessonIds"
      ]
    },
    "KnowledgeChunk": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "KnowledgeChunk",
      "type": "object",
      "description": "A chunk of text extracted from an uploaded document, used as a knowledge base for the AI.",
      "properties": {
        "sourceFile": {
          "type": "string",
          "description": "The name of the PDF file this chunk was extracted from."
        },
        "chunk": {
          "type": "string",
          "description": "The text content of this specific chunk."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when this chunk was created."
        }
      },
      "required": ["sourceFile", "chunk", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profile data. Access is restricted to the user themselves."
    },
    "/lessons/{lessonId}": {
      "schema": {
        "$ref": "#/entities/Lesson"
      },
      "description": "Stores static curriculum content. Write access is restricted to admins."
    },
     "/speakingTests/{testId}": {
      "schema": {
        "$ref": "#/entities/SpeakingTest"
      },
      "description": "Stores speaking practice prompts. Write access is restricted to admins."
    },
    "/mockTests/{testId}": {
      "schema": {
        "$ref": "#/entities/MockTest"
      },
      "description": "Stores mock test definitions. Write access is restricted to admins.",
      "queries": [
        {
          "type": "collection",
          "where": [["skill", "==", "Writing"]]
        }
      ]
    },
    "/readingTests/{testId}": {
        "schema": {
            "$ref": "#/entities/ReadingTest"
        },
        "description": "Stores reading practice tests. Write access is restricted to admins."
    },
    "/listeningTests/{testId}": {
        "schema": {
            "$ref": "#/entities/ListeningTest"
        },
        "description": "Stores listening practice tests. Write access is restricted to admins."
    },
    "/users/{userId}/submissions/{submissionId}": {
      "schema": {
        "$ref": "#/entities/Submission"
      },
      "description": "Stores user submissions and AI results. Access is restricted to the user themselves."
    },
    "/users/{userId}/learningPaths/{learningPathId}": {
      "schema": {
        "$ref": "#/entities/LearningPath"
      },
      "description": "Stores customized learning paths for users. Access is restricted to the user themselves."
    },
    "/knowledge/{chunkId}": {
      "schema": {
        "$ref": "#/entities/KnowledgeChunk"
      },
      "description": "Stores chunks of text from uploaded documents to be used as a knowledge base. Read is public, write is admin-only."
    }
  }
}
