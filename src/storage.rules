rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can read and write to their own speaking submissions directory.
    match /speaking-submissions/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read access for generated assets.
    match /lesson-images/{allPaths=**} {
      allow read: if true;
    }
    match /listeningTests/{allPaths=**} {
      allow read: if true;
    }
    match /writing-tasks/{allPaths=**} {
      allow read: if true;
    }
  }
}
