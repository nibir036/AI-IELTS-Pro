rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Allow public read access to all files. This is safe for non-sensitive
    // content like practice audio and images.
    allow read: if true;

    // Allow users to upload their own speaking submissions.
    match /speaking-submissions/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to upload images for their writing tasks.
    match /writing-tasks/{testId}/{allPaths=**} {
      allow write: if request.auth != null;
    }

    // Allow admins to upload images for lessons.
    match /lesson-images/{allPaths=**} {
      // This is a placeholder for a real admin check. For now, allow any signed-in user.
      // In production, this would use custom claims.
      allow write: if request.auth != null;
    }
    
    // Allow admins to upload audio for listening tests.
    match /listeningTests/{allPaths=**} {
       allow write: if request.auth != null;
    }
  }
}
