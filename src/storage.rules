rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Allow read and write access to all files for any signed-in user.
    // Access control will be managed by the frontend application logic.
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
