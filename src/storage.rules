
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Allow public read access to all files. This is safe for non-sensitive
    // content like practice audio and images.
    allow read: if true;

    // Allow admins to write to curriculum-related folders.
    match /writing-tasks/{allPaths=**} {
      allow write: if request.auth != null; // Simplified for demo
    }
     match /lesson-images/{allPaths=**} {
      allow write: if request.auth != null; // Simplified for demo
    }
    match /listeningTests/{allPaths=**} {
       allow write: if request.auth != null; // Simplified for demo
    }

    // Allow users to upload their own speaking submissions.
    match /speaking-submissions/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
