rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Allow an authenticated user to write to their own directory within 'speaking-submissions'.
    // The backend service will use a signed URL to read this file, which bypasses this rule check for the read operation.
    match /speaking-submissions/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Generated content is publicly readable for easy access by the app.
    match /lesson-images/{allPaths=**} {
      allow read: if true;
    }
    match /listeningTests/{allPaths=**} {
      allow read: if true;
    }
    match /writing-tasks/{allPaths=**} {
      allow read: if true;
    }
  }
}
