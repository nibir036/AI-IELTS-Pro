rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read for curriculum and generated assets
    match /lesson-images/{allPaths=**} {
      allow read: if true;
    }
    match /writing-tasks/{allPaths=**} {
      allow read: if true;
    }
    match /listeningTests/{allPaths=**} {
      allow read: if true;
    }

    // Users can read and write their own submissions.
    match /speaking-submissions/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback to deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
