rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to write to their own submission folder
    match /speaking-submissions/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read for generated assets like lesson images and test audio
    match /lesson-images/{allPaths=**} {
      allow read: if true;
    }
    match /listeningTests/{allPaths=**} {
      allow read: if true;
    }
    match /writing-tasks/{allPaths=**} {
      allow read: if true;
    }
    
    // Allow admins to manage all files if needed
    match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
