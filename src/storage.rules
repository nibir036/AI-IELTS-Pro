rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Default rule: Allow read and write access for any authenticated user.
    // This is suitable for development but should be replaced with more
    // restrictive rules for production to ensure data security.
    // e.g., match /speaking-submissions/{userId}/{allPaths=**} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
