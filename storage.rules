
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions for auth checks
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // In a real app, this should be based on custom claims, not hardcoded UIDs.
      let admin_uids = ['yTh2178GN3ZV3mAGi3wAmdPOKlm1'];
      return isSignedIn() && request.auth.uid in admin_uids;
    }

    // Public read for generated content (images, audio)
    match /lesson-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /writing-tasks/{allPaths=**} {
       allow read: if true;
       allow write: if isAdmin();
    }
     match /listeningTests/{allPaths=**} {
       allow read: if true;
       allow write: if isAdmin();
    }
    
    // User-specific uploads for speaking practice
    match /speaking-submissions/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
