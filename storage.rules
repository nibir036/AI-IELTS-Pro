rules_version = '2';

// Grant full access to backend flows (authenticated as admin) and public read for content.
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read access for all generated content.
    // Write access is limited to authenticated services (our backend flows).
    match /{path=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // More specific rules can be added here if needed, but the above rule
    // fulfills the request for full backend access and public read.
    // For example, user-specific uploads would be:
    // match /user-uploads/{userId}/{allPaths=**} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
  }
}
